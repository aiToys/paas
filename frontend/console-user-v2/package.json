{
  "name": "@paas/console-user-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PaaS 用户控制台 v2（新 IA 试验版）：产品为主线，服务=运行主语",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript http://localhost:8080/openapi.json -o src/api/types.gen.ts",
    "gen:skills": "node scripts/gen-skill-api.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:ux": "node --experimental-strip-types --test test/ux-contracts.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "element-plus": "^2.8.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-vue": "^5.1.0",
    "eslint": "^9",
    "eslint-plugin-vue": "^9",
    "globals": "^17.7.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
