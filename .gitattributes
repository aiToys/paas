# 统一文本文件行尾为 LF，避免 CRLF 混入导致 diff 噪声与 shell/Go 脚本跨平台问题。
* text=auto eol=lf

# 源码显式 LF
*.go       text eol=lf
*.ts       text eol=lf
*.vue      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf

# 二进制与生成产物，不做行尾转换、不参与 diff 合并
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
