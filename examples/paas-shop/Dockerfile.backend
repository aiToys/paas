# paas-shop 后端通用 Dockerfile：ARG SERVICE 指定服务（product/recommend/chatbot/bff）。
# 用 vendor（go mod vendor 生成），docker build 不需网络。
# 在 examples/ 目录 build：docker build -f examples/paas-shop/Dockerfile.backend --build-arg SERVICE=product -t <img> .
#
# 架构：builder 用 ARG TARGETPLATFORM 指定（DooD 构建集群节点均为 linux/amd64，原生跑无 QEMU；
# Mac arm64 本地构建传 --platform linux/amd64 交叉编译即可）。注意平台 DooD Job 用 classic builder
# （DOCKER_BUILDKIT=0，buildkit context transfer 有 bug），classic builder 无 buildkit 预定义
# $BUILDPLATFORM 自动变量——必须显式 ARG 声明 + --build-arg 传入，否则 parse platform 报错。
ARG TARGETPLATFORM=linux/amd64
FROM --platform=$TARGETPLATFORM docker.m.daocloud.io/library/golang:1.26-alpine AS builder
WORKDIR /app
COPY . .
ARG SERVICE
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -mod=vendor -o /svc ./paas-shop/${SERVICE}

FROM docker.m.daocloud.io/library/alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /svc /svc
ENTRYPOINT ["/svc"]
